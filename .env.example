# Base de datos (Neon en producción)
DATABASE_URL=postgres://usuario:pass@host/db?sslmode=require

# Auth.js — generá AUTH_SECRET con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL=contiguima@gmail.com

# Vista previa pública de SOLO LECTURA (sin login). Temporal: borrá esta variable para volver a proteger todo.
# PUBLIC_PREVIEW=1
